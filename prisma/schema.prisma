generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & PROFILE
// ============================================================

model Profile {
  id                         String   @id @default(cuid())
  displayName                String   @default("Sahil Depurwala")
  contactEmail               String   @default("tahaudaipurwala68@gmail.com")
  headline                   String   @default("Imperial Engineering & AI Architecture")
  bio                        String
  dateOfBirth                DateTime
  location                   String   @default("Kolkata, West Bengal, India")
  githubUrl                  String   @default("https://github.com/helloAi0")
  linkedinUrl                String   @default("https://linkedin.com")
  identityVerificationStatus String   @default("PENDING_OWNER_CONFIRMATION")
  identityFlagNotes          String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Education {
  id                 String   @id @default(cuid())
  institution        String
  institutionAcronym String?
  schoolType         String
  degree             String?
  field              String?
  minor              String?
  additionalInterest String?
  location           String
  startYear          Int
  endYear            Int?
  isCurrent          Boolean  @default(false)
  graduationStatus   String
  orderIndex         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ============================================================
// PROJECTS
// ============================================================

model ProjectCategory {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  icon        String?
  parentId    String?
  parent      ProjectCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    ProjectCategory[] @relation("CategoryHierarchy")
  projects    Project[]
  orderIndex  Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Project {
  id                     String          @id @default(cuid())
  slug                   String          @unique
  title                  String
  tagline                String
  description            String
  detailedExplanation    String
  categoryId             String
  category               ProjectCategory @relation(fields: [categoryId], references: [id])
  subcategory            String
  difficulty             String          @default("Advanced")
  githubRepo             String?
  liveDeployment         String?
  demoVideoUrl           String?
  architectureDiagramUrl String?
  problemStatement       String
  solution               String
  keyFeatures            String          // JSON array string
  challenges             String          // JSON array string
  results                String          // JSON array string
  status                 String          @default("Active")
  featured               Boolean         @default(false)
  orderIndex             Int             @default(0)
  githubSynced           Boolean         @default(false)
  githubRepoId           Int?
  githubStars            Int             @default(0)
  githubForks            Int             @default(0)
  githubLanguages        String?         // JSON map
  githubTopics           String?         // JSON array
  githubLastPushedAt     DateTime?
  approvalStatus         String          @default("APPROVED") // "APPROVED" | "PENDING_REVIEW" | "REJECTED"
  skills                 ProjectSkill[]
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

// ============================================================
// SKILLS
// ============================================================

model Skill {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  domain            String
  category          String
  subcategory       String?
  proficiencyLevel  String         @default("FOUNDATIONAL")
  level             String         @default("DETECTED") // "DETECTED"|"LEARNING"|"PRACTICING"|"OWNER_CONFIRMED"|"DEMONSTRATED"
  verified          Boolean        @default(false)
  detectedOnly      Boolean        @default(true)
  confidenceScore   Float          @default(0.5)
  evidenceNotes     String?
  evidenceSources   String?        // JSON array: ["github:repo-name", "certificate:id", "project:id"]
  firstDetectedAt   DateTime       @default(now())
  lastConfirmedAt   DateTime?
  icon              String?
  orderIndex        Int            @default(0)
  projects          ProjectSkill[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ProjectSkill {
  id        String   @id @default(cuid())
  projectId String
  skillId   String
  relevance String   @default("PRIMARY")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([projectId, skillId])
}

// ============================================================
// GITHUB INTEGRATION
// ============================================================

model GithubRepository {
  id               String    @id @default(cuid())
  githubId         Int       @unique
  name             String
  fullName         String    @unique
  description      String?
  htmlUrl          String
  cloneUrl         String?
  homepage         String?
  defaultBranch    String    @default("main")
  isPrivate        Boolean   @default(false)
  isFork           Boolean   @default(false)
  isArchived       Boolean   @default(false)
  stars            Int       @default(0)
  forks            Int       @default(0)
  openIssues       Int       @default(0)
  watchersCount    Int       @default(0)
  languages        String?   // JSON map
  topics           String?   // JSON array
  readmeContent    String?
  readmeSummary    String?
  licenseKey       String?
  pushedAt         DateTime?
  githubCreatedAt  DateTime?
  githubUpdatedAt  DateTime?
  classificationStatus   String   @default("PENDING")
  suggestedCategorySlug  String?
  suggestedSubcategory   String?
  suggestedSkills        String?
  classificationScore    Float    @default(0.0)
  classificationNotes    String?
  linkedProjectId        String?
  lastSyncedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ============================================================
// CODING PLATFORMS
// ============================================================

model CodingPlatformProfile {
  id              String    @id @default(cuid())
  platform        String    @unique
  username        String
  profileUrl      String
  totalSolved     Int?
  easySolved      Int?
  mediumSolved    Int?
  hardSolved      Int?
  contestRating   Float?
  globalRanking   Int?
  contributionPoints Int?
  badges          String?
  recentActivity  String?
  rawData         String?
  dataSource      String    @default("MOCK")
  lastSyncedAt    DateTime?
  syncError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ============================================================
// LINKEDIN
// ============================================================

model LinkedinPost {
  id             String    @id @default(cuid())
  title          String?
  contentExcerpt String
  postUrl        String?
  publishedAt    DateTime
  importMethod   String    @default("MANUAL")
  isPublic       Boolean   @default(true)
  isApproved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ============================================================
// CERTIFICATES & ACHIEVEMENTS
// ============================================================

model Certificate {
  id                  String    @id @default(cuid())
  title               String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?
  verificationStatus  String    @default("PENDING_VERIFICATION")
  description         String?
  skillsCovered       String?
  filePath            String?
  fileType            String?
  isPublic            Boolean   @default(false)
  ownerApproved       Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Achievement {
  id                 String    @id @default(cuid())
  title              String
  category           String
  organization       String
  date               DateTime?
  rankOrAward        String?
  verificationStatus String    @default("PENDING_VERIFICATION")
  description        String?
  proofUrl           String?
  isPublic           Boolean   @default(false)
  ownerApproved      Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ============================================================
// EXPERIENCE
// ============================================================

model Experience {
  id               String    @id @default(cuid())
  roleTitle        String
  organization     String
  organizationType String    @default("Organization")
  location         String?
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean   @default(false)
  description      String
  keyContributions String?
  skills           String?
  evidenceUrl      String?
  isPublic         Boolean   @default(true)
  verified         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ============================================================
// ADMIN & AUTH
// ============================================================

model AdminUser {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  role         String         @default("ADMIN")
  lastLogin    DateTime?
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

// ============================================================
// SYNC ENGINE
// ============================================================

model Integration {
  id           String    @id @default(cuid())
  platform     String    @unique
  identifier   String
  status       String    @default("PENDING")
  configData   String?
  lastSyncedAt DateTime?
  syncLogs     SyncLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model SyncLog {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  trigger       String      @default("MANUAL")
  status        String
  details       String?
  recordsSynced Int         @default(0)
  errorMessage  String?
  durationMs    Int?
  syncedAt      DateTime    @default(now())
}

// ============================================================
// OTHER CORE MODELS
// ============================================================

model SocialLink {
  id         String   @id @default(cuid())
  platform   String   @unique
  label      String
  url        String
  icon       String
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AiKnowledgeRecord {
  id                 String   @id @default(cuid())
  topic              String
  category           String
  content            String
  source             String?
  confidenceScore    Float    @default(1.0)
  verificationStatus String   @default("VERIFIED") // "VERIFIED" | "OWNER_CONFIRMED" | "IN_PROGRESS"
  visibility         String   @default("PUBLIC")   // "PUBLIC" | "PRIVATE"
  ownerApproved      Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model VisitorEnquiry {
  id          String   @id @default(cuid())
  senderName  String   @default("Anonymous Visitor")
  senderEmail String
  senderPhone String?
  subject     String   @default("Direct Portfolio Transmission")
  message     String   @default("Visitor initiated transmission via portfolio contact form.")
  status      String   @default("UNREAD")
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// WEEK 3: LAMO AI PORTFOLIO MANAGER & CONVERSATIONAL ENGINE
// ============================================================

model LamoConversation {
  id           String        @id @default(cuid())
  sessionId    String        @unique
  visitorName  String?
  visitorEmail String?
  messages     LamoMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model LamoMessage {
  id               String           @id @default(cuid())
  conversationId   String
  conversation     LamoConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String           // "USER" | "ASSISTANT" | "SYSTEM"
  content          String
  retrievedContext String?          // JSON array of citation sources used
  confidence       String?          // "VERIFIED" | "OWNER_CONFIRMED" | "IN_PROGRESS" | "UNKNOWN"
  suggestedActions String?          // JSON array of navigation pills [{label, href}]
  createdAt        DateTime         @default(now())
}

model UnansweredQuestion {
  id                  String    @id @default(cuid())
  questionId          String    @unique // e.g. "LQ-2026-8472"
  question            String
  context             String?
  category            String    @default("General") // "Robotics", "AI/ML", "Cybersecurity", "Experience", "Education"
  reason              String    // e.g. "No verified evidence found in database"
  status              String    @default("PENDING_OWNER") // "PENDING_OWNER" | "ANSWERED" | "REJECTED" | "PRIVATE_DECLINED"
  visitorName         String?
  visitorEmail        String?
  ownerAnswer         String?
  approvedKnowledgeId String?
  emailNotified       Boolean   @default(false)
  notifiedAt          DateTime?
  answeredAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BiographyReview {
  id                 String    @id @default(cuid())
  reviewDate         DateTime  @default(now())
  currentBio         String
  proposedBio        String
  reasons            String    // JSON array of reasons/detected milestones
  supportingEvidence String    // JSON array of new evidence sources
  status             String    @default("PENDING_APPROVAL") // "PENDING_APPROVAL" | "APPROVED" | "DECLINED"
  ownerFeedback      String?
  appliedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AdminAuditLog {
  id           String    @id @default(cuid())
  action       String    // e.g. "COPILOT_PROJECT_DESCRIPTION", "BIOGRAPHY_UPDATE", "QUESTION_APPROVED"
  target       String    // e.g. "Project:autonomous-rover-slam", "Profile"
  previousState String?  // JSON serialized prior snapshot for rollback
  newState     String?   // JSON serialized new state
  explanation  String?
  status       String    @default("COMMITTED") // "PREVIEW" | "COMMITTED" | "ROLLED_BACK"
  createdAt    DateTime  @default(now())
}
