# Local secrets for `npm run preview` (Cloudflare local runtime). Copy to .dev.vars. NEVER commit .dev.vars.
ADMIN_JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=
CRON_SECRET=
GITHUB_USERNAME=helloAi0
GITHUB_TOKEN=
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
OWNER_NOTIFICATION_EMAIL=
OWNER_BIRTH_DATE=
LEETCODE_USERNAME=
GFG_USERNAME=
LINKEDIN_PROFILE_URL=

# Fully automatic portfolio: public GitHub repositories become projects on their own (REVIEW = approve first)
PROJECT_PUBLICATION_MODE=AUTOMATIC

# Certificate ingestion worker (see worker/README.md). INGEST_SECRET must be 24+ chars and identical on the worker.
INGEST_SECRET=
INGEST_WORKER_URL=
# Job agent: your phone for the admin-only application-form box (never stored in the repo)
OWNER_PHONE=

# Outreach Agent dashboard (read-only view of the n8n agent's Google Sheet; see docs/OUTREACH_DASHBOARD.md).
# NO Apify / Apollo / Hunter / OpenAI keys belong here: those live only in n8n.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
OUTREACH_SHEET_ID=
# "Run scan now" button: n8n production webhook URL (…/webhook/outreach-run-now) and the shared secret set as N8N_RUN_SECRET in n8n.
N8N_RUN_WEBHOOK_URL=
N8N_RUN_SECRET=
