    {
      "id": "f2f0cc22-1c1e-4614-994c-3529ce35ea50",
      "name": "Match Incoming Reply to Contact and Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const messages=$('Gmail Trigger — Every Hour').all().map(x=>x.json);\nconst contacts=$('Read Contacts — Reply Match').all().map(x=>x.json);\nconst jobs=$('Read Jobs — Reply Match').all().map(x=>x.json);\nconst logs=$('Read Log — Reply Idempotency').all().map(x=>x.json);\nconst handled=new Set(logs.map(x=>String(x['Message ID']||'')).filter(Boolean));\nconst out=[];\nfor(const m of messages){\n const id=String(m.id||m.messageId||''); if(!id||handled.has(id)) continue;\n const from=String(m.From||m.from||''); const match=from.match(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}/i); if(!match) continue;\n const email=match[0].toLowerCase();\n const contact=contacts.find(c=>String(c.Email||'').toLowerCase()===email && String(c['Contact State']||'').toLowerCase()==='contacted');\n if(!contact) continue;\n const job=jobs.find(j=>String(j['Job Link']||'')===String(contact['Job Link']||'')); if(!job) continue;\n const full=String(m.textPlain||m.text||m.snippet||'').split(/\\n\\s*>|\\nOn .{5,120}wrote:|\\n-{2,}\\s*Original Message/i)[0]; const text=full.toLowerCase().trim().slice(0,400);\n const optOut=/\\b(unsubscribe|remove me|do not contact|don't contact|do not email|don't email|no more emails|take me off|stop (emailing|contacting|messaging)|please stop)\\b/.test(text) || /^\\s*(no|stop|unsubscribe)\\s*[.!?]*\\s*$/.test(text) || /^\\s*no,?\\s+(thanks|thank you|thx)[\\s.!]*$/.test(text);\n out.push({json:{'Message ID':id,'Contact Email':email,'Job Link':job['Job Link'],'Company':job.Company,'Status':optOut?'Opted Out':'Replied','Replied':'Y','Reply Detected At':new Date().toISOString(),'Opted Out':optOut?'Y':'N','Contact State':optOut?'Do Not Contact':'Contacted','Last Message Date':new Date().toISOString(),'Reply Subject':m.Subject||'','Reply Snippet':String(m.snippet||m.text||'').slice(0,500)}});\n}\nreturn out;"
      }
    },
