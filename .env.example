# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. Every value below is
# a placeholder: there are no usable secrets in this file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------

# Database. Local SQLite works with zero setup:
DATABASE_URL="file:./dev.db"
# Render PostgreSQL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portfolio?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public identity
OWNER_DISPLAY_NAME="Taha Udaipurwala"
OWNER_CONTACT_EMAIL="tahaudaipurwala68@gmail.com"
# Set to VERIFIED after you have reviewed the public profile.
IDENTITY_VERIFICATION_STATUS="PENDING_OWNER_CONFIRMATION"

# PRIVATE profile settings (server-only, never shown publicly)
# Birth date as YYYY-MM-DD. Used only to compute age in Asia/Kolkata.
OWNER_BIRTH_DATE=
# Age is shown publicly only when this is exactly "true".
OWNER_SHOW_PUBLIC_AGE="false"
# Exact awarding institution, once you have confirmed it. Empty = not displayed.
OWNER_INSTITUTION=

# GitHub
GITHUB_USERNAME="helloAi0"
# Optional personal access token (raises the rate limit)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Coding platforms: leave empty until you have verified the real usernames.
LEETCODE_USERNAME=
GFG_USERNAME=
# Optional. GeeksforGeeks has no official API; only set this to a data source you trust.
# URL template containing {username}.
GFG_STATS_ENDPOINT=

# LinkedIn: your real profile URL. Empty = LinkedIn is not shown.
LINKEDIN_PROFILE_URL=

# Admin (required: no defaults exist)
ADMIN_USERNAME="taha"
ADMIN_JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=

# Scheduled reconciliation endpoint protection
CRON_SECRET=

# LAMO AI and email
GEMINI_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=
OWNER_NOTIFICATION_EMAIL="tahaudaipurwala68@gmail.com"
