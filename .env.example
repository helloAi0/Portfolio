# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. Every value below is
# a placeholder: there are no usable secrets in this file.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------

# Database. Local SQLite works with zero setup:
DATABASE_URL="file:./dev.db"
# Render PostgreSQL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/portfolio?schema=public"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public identity
OWNER_DISPLAY_NAME="Taha Udaipurwala"
OWNER_CONTACT_EMAIL="tahaudaipurwala68@gmail.com"
# Set to VERIFIED after you have reviewed the public profile.
IDENTITY_VERIFICATION_STATUS="PENDING_OWNER_CONFIRMATION"

# PRIVATE profile settings (server-only, never shown publicly)
# Birth date as YYYY-MM-DD. Used only to compute age in Asia/Kolkata.
OWNER_BIRTH_DATE=
# Age is shown publicly only when this is exactly "true".
OWNER_SHOW_PUBLIC_AGE="false"
# Exact awarding institution, once you have confirmed it. Empty = not displayed.
OWNER_INSTITUTION=

# GitHub
GITHUB_USERNAME="helloAi0"
# Optional personal access token (raises the rate limit)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Optional: include forks as project candidates (default false)
GITHUB_INCLUDE_FORKS=false
# REVIEW (default): nothing becomes a public project until you approve it.
# AUTOMATIC: only high-confidence (>=0.8) suggestions are auto-published; you can still unpublish.
PROJECT_PUBLICATION_MODE="AUTOMATIC"  # AUTOMATIC publishes confident repositories by itself; REVIEW waits for your approval

# Coding platforms: leave empty until you have verified the real usernames.
LEETCODE_USERNAME="WLq0hyCLJz"   # from leetcode.com/u/WLq0hyCLJz
GFG_USERNAME="tahaudaip7eby"      # from geeksforgeeks.org/profile/tahaudaip7eby
# Optional. GeeksforGeeks has no official API; only set this to a data source you trust.
# URL template containing {username}.
GFG_STATS_ENDPOINT=

# LinkedIn: your real profile URL. Empty = LinkedIn is not shown.
LINKEDIN_PROFILE_URL=

# Admin (required: no defaults exist)
ADMIN_EMAIL="tahaudaipurwala68@gmail.com"
ADMIN_USERNAME="taha"
ADMIN_JWT_SECRET=
ADMIN_DEFAULT_PASSWORD=

# Scheduled reconciliation endpoint protection
CRON_SECRET=

# LAMO AI and email
GEMINI_API_KEY=
# Optional. Model used by LAMO when GEMINI_API_KEY is set. Without a key LAMO uses its deterministic grounded engine.
LAMO_GEMINI_MODEL="gemini-2.5-flash"
# Max Gemini calls per day (protects your quota)
LAMO_DAILY_LLM_CAP=300
# Number of trusted reverse-proxy hops in front of the app (Render = 1). Used for rate limiting by IP.
TRUSTED_PROXY_HOPS=1
# Optional custom reply when a visitor asks for private data
LAMO_PRIVATE_REFUSAL=
RESEND_API_KEY=
EMAIL_FROM=
# Where LAMO sends unanswered-question alerts. Defaults to OWNER_CONTACT_EMAIL.
OWNER_NOTIFICATION_EMAIL=

# Automatic background sync (GitHub, LeetCode, GFG). Runs inside the server on Render.
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=6

# Certificate ingestion worker (see worker/README.md). INGEST_SECRET must be 24+ chars and identical on the worker.
INGEST_SECRET=
INGEST_WORKER_URL=
# Job agent: your phone for the admin-only application-form box (never stored in the repo)
OWNER_PHONE=
