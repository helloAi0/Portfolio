{
  "name": "project-lamo-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "lint": "node node_modules/next/dist/bin/next lint",
    "test": "node node_modules/tsx/dist/cli.mjs scripts/test_week4_comprehensive.ts",
    "admin:set": "node node_modules/tsx/dist/cli.mjs scripts/set-admin.ts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "backup": "node node_modules/tsx/dist/cli.mjs scripts/backup.ts",
    "restore": "node node_modules/tsx/dist/cli.mjs scripts/restore_backup.ts",
    "test:unit": "node node_modules/tsx/dist/cli.mjs scripts/test_identity_and_honesty.ts && node node_modules/tsx/dist/cli.mjs scripts/test_week2_sync.ts && node node_modules/tsx/dist/cli.mjs scripts/test_week3_unit.ts && node node_modules/tsx/dist/cli.mjs scripts/test_automation_mocked.ts && node node_modules/tsx/dist/cli.mjs scripts/test_week4_unit.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "postinstall": "node scripts/postinstall.mjs",
    "d1:migration": "node scripts/gen-d1-migration.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed-sql": "node node_modules/tsx/dist/cli.mjs scripts/dump-sql.ts",
    "cf:build": "node scripts/cf-build.mjs",
    "preview": "node scripts/cf-build.mjs && opennextjs-cloudflare preview",
    "deploy": "node scripts/cf-build.mjs && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types",
    "check:deploy": "node scripts/deploy-check.mjs",
    "db:local": "node node_modules/tsx/dist/cli.mjs scripts/init-local-db.ts",
    "db:local:init": "node node_modules/tsx/dist/cli.mjs scripts/init-local-db.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.12.0",
    "@prisma/adapter-d1": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@types/jsonwebtoken": "^9.0.10",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.475.0",
    "next": "^14.2.24",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.174.0",
    "wrangler": "^4.45.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/internals": "^6.19.3",
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.174.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}